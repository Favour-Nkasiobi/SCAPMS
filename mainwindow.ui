  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #F4F7FB;
}

QWidget {
    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
    color: #243247;
}

QTabWidget::pane {
    border: 1px solid #DCE4EE;
    background-color: #FFFFFF;
    border-radius: 10px;
    top: -1px;
}

QTabBar::tab {
    background-color: #E8EEF5;
    color: #42536A;
    padding: 12px 24px;
    margin-right: 4px;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    min-width: 90px;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #079B8E;
    border-bottom: 3px solid #079B8E;
    font-weight: bold;
}

QPushButton {
    background-color: #079B8E;
    color: white;
    border: none;
    border-radius: 7px;
    padding: 9px 16px;
    min-height: 18px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #067F75;
}

QPushButton:pressed {
    background-color: #05665F;
}

QLineEdit, QSpinBox, QDateEdit, QTimeEdit, QComboBox, QTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 7px;
    selection-background-color: #079B8E;
}

QLineEdit:focus, QSpinBox:focus, QDateEdit:focus,
QTimeEdit:focus, QComboBox:focus, QTextEdit:focus {
    border: 2px solid #079B8E;
}

QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F1F5F9;
    border: 1px solid #DCE4EE;
    border-radius: 7px;
    gridline-color: #E2E8F0;
    selection-background-color: #D5F3EE;
    selection-color: #173B37;
}

QHeaderView::section {
    background-color: #E8EEF5;
    color: #243247;
    padding: 10px;
    border: none;
    border-bottom: 1px solid #CBD5E1;
    font-weight: bold;
}

QLabel {
    background-color: transparent;
}</string>
